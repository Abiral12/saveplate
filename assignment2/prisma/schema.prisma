generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum ListingVisibility {
  PRIVATE
  PUBLIC
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  fullName        String        @map("full_name") @db.VarChar(100)
  email           String        @unique(map: "uk_users_email") @db.VarChar(320)
  passwordHash    String        @map("password_hash") @db.VarChar(255)
  householdSize   Int?          @map("household_size")
  status          AccountStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?     @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions          Session[]
  foodItems         FoodItem[]
  verificationCodes EmailVerificationCode[]
  privacySetting    PrivacySetting?

  donatedListings  DonationListing[] @relation("DonationDonor")
  donationRequests DonationRequest[] @relation("DonationRequester")

  @@index([status], map: "idx_users_status")
  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique(map: "uk_sessions_token_hash") @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  userAgent String?   @map("user_agent") @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "idx_sessions_user_expiry")
  @@index([expiresAt, revokedAt], map: "idx_sessions_expiry_revoked")
  @@map("sessions")
}

model EmailVerificationCode {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  codeHash     String    @map("code_hash") @db.Char(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt, usedAt], map: "idx_verification_user_expiry")
  @@map("email_verification_codes")
}

model PrivacySetting {
  id                     String            @id @default(uuid()) @db.Uuid
  userId                 String            @unique(map: "uk_privacy_settings_user") @map("user_id") @db.Uuid
  listingVisibility      ListingVisibility @default(PRIVATE) @map("listing_visibility")
  showContactInformation Boolean           @default(false) @map("show_contact_information")
  expiryAlertsEnabled    Boolean           @default(true) @map("expiry_alerts_enabled")
  donationAlertsEnabled  Boolean           @default(true) @map("donation_alerts_enabled")
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

enum FoodItemStatus {
  AVAILABLE
  USED
  DISCARDED
  RESERVED
  DONATED
}

model FoodItem {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  itemName String @map("item_name") @db.VarChar(150)

  quantity Decimal @db.Decimal(10, 2)

  unit String @db.VarChar(30)

  expiryDate DateTime @map("expiry_date") @db.Date

  category String @db.VarChar(50)

  storageLocation String? @map("storage_location") @db.VarChar(50)

  status FoodItemStatus @default(AVAILABLE)

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  donationListings DonationListing[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, expiryDate])
  @@index([userId, category])
  @@map("food_items")
}

enum DonationListingStatus {
  AVAILABLE
  RESERVED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum DonationRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CLAIMED
  CANCELLED
}

model DonationListing {
  id String @id @default(uuid()) @db.Uuid

  foodItemId String @map("food_item_id") @db.Uuid
  donorId    String @map("donor_id") @db.Uuid

  pickupLocation      String  @map("pickup_location") @db.VarChar(250)
  availabilityDetails String  @map("availability_details") @db.VarChar(500)
  notes               String? @db.Text

  status DonationListingStatus @default(AVAILABLE)

  cancelledAt DateTime? @map("cancelled_at")
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  foodItem FoodItem @relation(fields: [foodItemId], references: [id], onDelete: Restrict)

  donor User @relation("DonationDonor", fields: [donorId], references: [id], onDelete: Cascade)

  requests DonationRequest[]

  @@unique([foodItemId], map: "uq_active_donation_per_food_item", where: raw("status IN ('AVAILABLE', 'RESERVED')"))
  @@index([donorId, status])
  @@index([status, createdAt])
  @@index([foodItemId])
  @@map("donation_listings")
}

model DonationRequest {
  id String @id @default(uuid()) @db.Uuid

  listingId   String @map("listing_id") @db.Uuid
  requesterId String @map("requester_id") @db.Uuid

  message String? @db.VarChar(500)

  status DonationRequestStatus @default(PENDING)

  respondedAt DateTime? @map("responded_at")
  claimedAt   DateTime? @map("claimed_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  listing DonationListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  requester User @relation("DonationRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([listingId, requesterId])
  @@unique([listingId], map: "uq_selected_request_per_listing", where: raw("status IN ('ACCEPTED', 'CLAIMED')"))
  @@index([requesterId, status])
  @@index([listingId, status])
  @@index([createdAt])
  @@map("donation_requests")
}